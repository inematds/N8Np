    {
      "parameters": {
        "jsCode": "// Processar webhook do WhatsApp Business API\nconst body = $json.body || $json;\n\n// Verificar se é uma mensagem válida\nif (!body.entry || !body.entry[0] || !body.entry[0].changes) {\n  return {\n    json: {\n      error: 'Invalid webhook payload',\n      original: body\n    }\n  };\n}\n\nconst changes = body.entry[0].changes[0];\nconst value = changes.value;\n\n// Verificar se há mensagens\nif (!value.messages || value.messages.length === 0) {\n  // Pode ser status de entrega, leitura, etc.\n  return {\n    json: {\n      type: 'status_update',\n      data: value\n    }\n  };\n}\n\nconst message = value.messages[0];\nconst contact = value.contacts ? value.contacts[0] : null;\n\n// Extrair informações da mensagem\nconst messageData = {\n  id: message.id,\n  from: message.from,\n  timestamp: message.timestamp,\n  type: message.type,\n  text: null,\n  media: null,\n  location: null,\n  contact_info: null\n};\n\n// Processar diferentes tipos de mensagem\nswitch (message.type) {\n  case 'text':\n    messageData.text = message.text.body;\n    break;\n  case 'image':\n  case 'video':\n  case 'audio':\n  case 'document':\n    messageData.media = {\n      id: message[message.type].id,\n      mime_type: message[message.type].mime_type,\n      caption: message[message.type].caption || null\n    };\n    break;\n  case 'location':\n    messageData.location = {\n      latitude: message.location.latitude,\n      longitude: message.location.longitude,\n      name: message.location.name,\n      address: message.location.address\n    };\n    break;\n  case 'contacts':\n    messageData.contact_info = message.contacts[0];\n    break;\n}\n\n// Informações do contato\nconst contactData = {\n  wa_id: contact?.wa_id || message.from,\n  profile_name: contact?.profile?.name || 'Usuário WhatsApp'\n};\n\n// Verificar se é mensagem de sistema ou bot\nconst isSystemMessage = message.from === value.metadata?.phone_number_id;\n\nif (isSystemMessage) {\n  return {\n    json: {\n      type: 'system_message',\n      message: 'Mensagem do próprio sistema ignorada'\n    }\n  };\n}\n\n// Preparar dados para o orquestrador\nconst orchestratorPayload = {\n  canal: 'whatsapp',\n  from: message.from,\n  telefone: message.from,\n  mensagem: messageData.text || `[${message.type.toUpperCase()}]`,\n  tipo_mensagem: message.type,\n  timestamp: new Date(parseInt(message.timestamp) * 1000).toISOString(),\n  dados_completos: {\n    message: messageData,\n    contact: contactData,\n    metadata: value.metadata\n  }\n};\n\nreturn {\n  json: {\n    type: 'new_message',\n    processed_data: orchestratorPayload,\n    raw_data: body\n  }\n};"
      },
