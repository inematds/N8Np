    {
      "parameters": {
        "jsCode": "// Preparar mensagem para envio via WhatsApp Business API\nconst dados = $json;\n\n// Validar dados obrigatórios\nif (!dados.to || !dados.message) {\n  throw new Error('Campos obrigatórios: to, message');\n}\n\n// Limpar número de telefone (remover caracteres especiais)\nconst numeroLimpo = dados.to.replace(/\\D/g, '');\n\n// Adicionar código do país se não tiver\nlet numeroCompleto = numeroLimpo;\nif (!numeroCompleto.startsWith('55') && numeroCompleto.length === 11) {\n  numeroCompleto = '55' + numeroCompleto;\n}\n\n// Preparar payload para WhatsApp Business API\nconst payload = {\n  messaging_product: 'whatsapp',\n  to: numeroCompleto,\n  type: 'text',\n  text: {\n    body: dados.message\n  }\n};\n\n// Se tiver template, usar template em vez de texto livre\nif (dados.template) {\n  payload.type = 'template';\n  payload.template = {\n    name: dados.template.name,\n    language: {\n      code: dados.template.language || 'pt_BR'\n    }\n  };\n  \n  if (dados.template.parameters) {\n    payload.template.components = [\n      {\n        type: 'body',\n        parameters: dados.template.parameters.map(param => ({\n          type: 'text',\n          text: param\n        }))\n      }\n    ];\n  }\n  \n  delete payload.text;\n}\n\n// Se tiver mídia\nif (dados.media) {\n  payload.type = dados.media.type; // image, video, audio, document\n  payload[dados.media.type] = {\n    link: dados.media.url\n  };\n  \n  if (dados.media.caption) {\n    payload[dados.media.type].caption = dados.media.caption;\n  }\n  \n  delete payload.text;\n}\n\nreturn {\n  json: {\n    payload: payload,\n    numero_original: dados.to,\n    numero_processado: numeroCompleto,\n    tipo_envio: payload.type\n  }\n};"
      },
