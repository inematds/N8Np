    {
      "parameters": {
        "jsCode": "// Verificação do webhook do WhatsApp\nconst query = $json.query;\n\n// Verificar se é uma solicitação de verificação\nif (query['hub.mode'] === 'subscribe' && \n    query['hub.verify_token'] === $vars.WHATSAPP_VERIFY_TOKEN) {\n  \n  return {\n    json: {\n      challenge: query['hub.challenge'],\n      verified: true\n    }\n  };\n}\n\nreturn {\n  json: {\n    error: 'Verification failed',\n    received: query\n  }\n};"
      },
      "id": "processar-verificacao",
      "name": "Processar Verificação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        900
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge || 'Verification failed' }}"
      },
      "id": "resposta-verificacao",
      "name": "Resposta Verificação",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
