      "parameters": {
        "jsCode": "// n8n Function Node\nreturn items.map(item => {\n  try {\n    // 1. Extraemos el string del output\n    const rawOutput = item.json.output;\n\n    // 2. Parseamos el string como JSON válido\n    const parsed = JSON.parse(rawOutput);\n\n    // 3. Retornamos un nuevo objeto con texto y url\n    return {\n      json: {\n        texto: parsed.texto || \"\",\n        url: parsed.url || \"\"\n      }\n    };\n  } catch (error) {\n    // Si falla el parseo, devolvemos el error\n    return {\n      json: {\n        error: \"No se pudo parsear el output\",\n        detalle: error.message,\n        raw: item.json.output\n      }\n    };\n  }\n});\n"
      },
