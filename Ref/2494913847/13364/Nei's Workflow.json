    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following video transcription and segment it into 5-minute topic chunks. For each segment, extract:\n\n1. A descriptive title for the topic discussed\n2. Relevant keywords (3-5 key terms)\n3. Start and end timestamps\n4. The segment text content\n\nTranscription: {{ $('Transcribe Audio').item.json.text }}\n\nReturn the results as a JSON array where each segment contains:\n- video_id: Use the video ID from the stream data\n- segment_text: The actual text content for this time segment\n- topic: A concise title describing the main topic\n- keywords: Array of 3-5 relevant keywords\n- start_time: Start timestamp in seconds\n- end_time: End timestamp in seconds\n\nEnsure segments are approximately 5 minutes (300 seconds) each, but adjust boundaries to natural topic breaks when possible.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert video content analyzer. Your task is to segment video transcriptions into meaningful topic-based chunks and extract structured metadata. Focus on identifying natural topic boundaries and extracting the most relevant keywords for each segment. Always return valid JSON format.",
          "maxIterations": 10,
          "returnIntermediateSteps": false
        }
      },
      "id": "7fdb8f0f-4548-4c7f-8f07-c2f0fd0b93a8",
      "name": "Segment and Extract Topics",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        2080,
        1408
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "segments",
        "options": {}
      },
      "id": "63cec7ef-1f05-46c7-aadc-12e03dcad467",
      "name": "Split Segments",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2432,
        1408
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "video_id",
              "value": "={{ $('Check Live Streams').item.json.id }}",
              "type": "string"
            },
            {
