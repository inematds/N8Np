        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Evaluación de la página web + Recomendaciones</title>\n  <!-- Normalización mínima para las secciones inyectadas -->\n  <style>\n    /* Gmail respeta CSS básico en <style>. Esto unifica tamaños y look del HTML que devuelve el modelo */\n    section#evaluaciones, section#recomendaciones {\n      font-family: Arial, Helvetica, sans-serif !important;\n      font-size: 14px !important;\n      line-height: 1.6 !important;\n      color: #333333 !important;\n      margin: 0 0 0 0 !important;\n    }\n    section#evaluaciones h1, section#evaluaciones h2,\n    section#recomendaciones h1, section#recomendaciones h2 {\n      font-family: Arial, Helvetica, sans-serif !important;\n      color: #3A2C76 !important;\n      margin: 16px 0 8px !important;\n    }\n    section#evaluaciones h1, section#recomendaciones h1 { font-size: 20px !important; }\n    section#evaluaciones h2, section#recomendaciones h2 { font-size: 18px !important; }\n\n    /* Diferenciación visual clara de la sección de Recomendaciones */\n    section#recomendaciones {\n      background: #F8F4FF !important;           /* lila muy suave */\n      border: 1px solid #E9D8FD !important;     /* morado pastel */\n      border-left: 6px solid #8B5CF6 !important;\n      border-radius: 12px !important;\n      padding: 16px 16px !important;\n      margin-top: 10px !important;\n    }\n    section#evaluaciones {\n      background: #FFFFFF !important;\n      border: 1px solid #EFE7FF !important;\n      border-left: 6px solid #C4A8FF !important;\n      border-radius: 12px !important;\n      padding: 16px 16px !important;\n      margin-top: 10px !important;\n    }\n    section#recomendaciones ol { margin: 10px 0 0 18px !important; padding: 0 !important; }\n    section#recomendaciones ol > li { margin: 10px 0 !important; }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background:#FAF7FF;\">\n  <center style=\"width:100%; background:#FAF7FF;\">\n    <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"max-width:820px; margin:0 auto;\">\n      <tr>\n        <td style=\"padding:24px 16px;\">\n\n          <!-- Tarjeta -->\n          <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background:#FFFFFF; border-radius:16px; overflow:hidden; box-shadow:0 8px 28px rgba(139,92,246,0.18);\">\n            <!-- Header -->\n            <tr>\n              <td style=\"background:linear-gradient(90deg,#D8B4FE,#8B5CF6); padding:28px;\">\n                <h1 style=\"margin:0; font-family:Arial, Helvetica, sans-serif; font-size:22px; line-height:1.3; color:#FFFFFF;\">\n                  Evaluación de la página web + Recomendaciones personalizadas\n                </h1>\n                <p style=\"margin:8px 0 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#F7F2FF;\">\n                  Informe listo para compartir con el cliente\n                </p>\n              </td>\n            </tr>\n\n            <!-- Chips de guía -->\n            <tr>\n              <td style=\"padding:18px 28px 0 28px;\">\n                <span style=\"display:inline-block; background:#8B5CF6; color:#FFFFFF; font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:bold; padding:6px 10px; border-radius:999px; margin-right:6px;\">\n                  Evaluación de la página web\n                </span>\n                <span style=\"display:inline-block; background:#E9D8FD; color:#3A2C76; font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:bold; padding:6px 10px; border-radius:999px;\">\n                  Recomendaciones de mejora\n                </span>\n              </td>\n            </tr>\n\n            <!-- CONTENIDO INYECTADO DEL MODELO -->\n            <tr>\n              <td style=\"padding:12px 28px 8px 28px;\">\n                <!-- El módulo de OpenAI debe devolver:\n                     <section id=\"evaluaciones\">...</section>\n                     <section id=\"recomendaciones\">...</section>\n                     Lo incrustamos tal cual y el CSS de arriba lo normaliza/diferencia -->\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#333333; line-height:1.6;\">\n                  {{ $('Message a model').item.json.message.content }}\n                </div>\n              </td>\n            </tr>\n\n            <!-- CTA final solicitado -->\n            <tr>\n              <td style=\"padding:4px 28px 24px 28px;\">\n                <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background:#FFFFFF; border:1px solid #EFE7FF; border-radius:12px;\">\n                  <tr>\n                    <td style=\"padding:18px 20px;\">\n                      <p style=\"margin:0 0 12px 0; font-family:Arial, Helvetica, sans-serif; font-size:15px; color:#3A2C76; font-weight:bold;\">\n                        ¿Quieres que te ayudemos a implementar todas estas mejoras?\n                      </p>\n                      <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                        <tr>\n                          <td style=\"background:#8B5CF6; border-radius:10px;\">\n                            <a href=\"https://solutechia.es\" target=\"_blank\" style=\"display:inline-block; padding:12px 18px; font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#FFFFFF; text-decoration:none; font-weight:bold;\">\n                              Sí, quiero ayuda\n                            </a>\n                          </td>\n                        </tr>\n                      </table>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n          </table>\n          <!-- /Tarjeta -->\n\n          <!-- Pie -->\n          <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"margin-top:16px;\">\n            <tr>\n              <td style=\"text-align:center; padding:8px 0;\">\n                <p style=\"margin:0; font-family:Arial, Helvetica, sans-serif; font-size:12px; color:#7A6CA8;\">\n                  © 2025 Solutech IA · Informe de Optimización de Conversión\n                </p>\n              </td>\n            </tr>\n          </table>\n\n        </td>\n      </tr>\n    </table>\n  </center>\n</body>\n</html>\n",
