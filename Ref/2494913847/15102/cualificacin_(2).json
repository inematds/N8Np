          "customCss": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Formulario de Cualificación</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Paleta de colores basada en tu logotipo */\n            --primary-dark: #121f3d; /* Azul oscuro del logo */\n            --primary-accent: #00b8d4; /* Cian brillante del logo */\n            --text-primary: #121f3d; /* Texto principal oscuro */\n            --text-secondary: #5a647e; /* Texto secundario/etiquetas */\n            --background-page: #f0f4f8; /* Fondo de la página */\n            --background-card: #ffffff; /* Fondo del formulario */\n            --border-color: #dbe1e8; /* Color del borde de los inputs */\n            --error-color: #e53935; /* Color para mensajes de error */\n\n            /* Tipografía y espaciado */\n            --font-family: 'Poppins', sans-serif;\n            --border-radius-card: 12px;\n            --border-radius-input: 8px;\n            --shadow-card: 0 10px 30px rgba(18, 31, 61, 0.1);\n        }\n\n        /* --- Estilos Generales --- */\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: var(--font-family);\n            background-color: var(--background-page);\n            color: var(--text-primary);\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            padding: 2rem;\n        }\n\n        /* --- Contenedor Principal del Formulario --- */\n        .form-container {\n            background-color: var(--background-card);\n            border-radius: var(--border-radius-card);\n            box-shadow: var(--shadow-card);\n            padding: 2.5rem;\n            max-width: 600px;\n            width: 100%;\n            text-align: center;\n        }\n\n        /* --- Logotipo --- */\n        .logo {\n            max-width: 180px;\n            margin-bottom: 1.5rem;\n        }\n\n        /* --- Títulos y Descripción --- */\n        h1 {\n            font-size: 1.75rem;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n        }\n\n        .form-description {\n            font-size: 1rem;\n            color: var(--text-secondary);\n            margin-bottom: 2rem;\n        }\n\n        /* --- Grupos de Campos (Label + Input) --- */\n        .form-group {\n            margin-bottom: 1.5rem;\n            text-align: left;\n        }\n\n        label {\n            display: block;\n            font-size: 0.9rem;\n            font-weight: 600;\n            color: var(--text-primary);\n            margin-bottom: 0.5rem;\n        }\n\n        label .required {\n            color: var(--primary-accent);\n            margin-left: 4px;\n        }\n\n        /* --- Estilos para Inputs, Textarea y Select --- */\n        input[type=\"text\"],\n        input[type=\"email\"],\n        input[type=\"tel\"],\n        textarea,\n        select {\n            width: 100%;\n            padding: 0.9rem;\n            font-family: var(--font-family);\n            font-size: 1rem;\n            color: var(--text-primary);\n            background-color: #f9fafb;\n            border: 1px solid var(--border-color);\n            border-radius: var(--border-radius-input);\n            transition: border-color 0.3s, box-shadow 0.3s;\n        }\n\n        input::placeholder, textarea::placeholder {\n            color: #a0aec0;\n        }\n\n        input:focus,\n        textarea:focus,\n        select:focus {\n            outline: none;\n            border-color: var(--primary-accent);\n            box-shadow: 0 0 0 3px rgba(0, 184, 212, 0.2);\n        }\n\n        textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n        \n        select {\n            -webkit-appearance: none;\n            -moz-appearance: none;\n            appearance: none;\n            background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%2300B8D4%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E');\n            background-repeat: no-repeat;\n            background-position: right 1rem center;\n            background-size: 0.8em;\n            cursor: pointer;\n        }\n\n        /* --- Botón de Envío --- */\n        .submit-btn {\n            width: 100%;\n            padding: 1rem;\n            font-family: var(--font-family);\n            font-size: 1rem;\n            font-weight: 600;\n            color: #fff;\n            background: linear-gradient(90deg, var(--primary-accent) 0%, var(--primary-dark) 100%);\n            border: none;\n            border-radius: var(--border-radius-input);\n            cursor: pointer;\n            transition: transform 0.2s, box-shadow 0.2s;\n            margin-top: 1rem;\n        }\n\n        .submit-btn:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(0, 184, 212, 0.3);\n        }\n\n    </style>\n</head>\n<body>\n\n    <div class=\"form-container\">\n        <img src=\"https://assets.cdn.filesafe.space/Uy9m8TcMt4JmuInzfXkf/media/6825d1af523c176f249acf51.jpeg\" alt=\"Logotipo de la Empresa\" class=\"logo\">\n        \n        <h1>Déjanos que te ayudemos</h1>\n        <p class=\"form-description\">Responde a las siguientes preguntas para saber qué podemos hacer en tu negocio.</p>\n\n        <form action=\"PEGA_AQUÍ_LA_URL_DE_TU_NODO_FORM_TRIGGER\" method=\"POST\">\n            \n            <div class=\"form-group\">\n                <label for=\"empresa\">Nombre de la Empresa<span class=\"required\">*</span></label>\n                <input type=\"text\" id=\"empresa\" name=\"empresa\" placeholder=\"Ej: Muebles SA\" required>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"nombre\">Tu nombre<span class=\"required\">*</span></label>\n                <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Ej: Luis\" required>\n            </div>\n            \n            <div class=\"form-group\">\n                <label for=\"nicho\">¿De qué nicho es tu empresa?<span class=\"required\">*</span></label>\n                <input type=\"text\" id=\"nicho\" name=\"nicho\" placeholder=\"Ej: Decoración\" required>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"cargo\">¿Qué cargo ocupas dentro de la empresa?<span class=\"required\">*</span></label>\n                <input type=\"text\" id=\"cargo\" name=\"cargo\" placeholder=\"Ej: CEO\" required>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"problemas\">Lístame los 3 problemas que más te preocupan<span class=\"required\">*</span></label>\n                <textarea id=\"problemas\" name=\"problemas\" placeholder=\"Ej: 1. Gestionar facturas, 2. Responder emails de soporte, 3. Seguimiento de clientes...\" required></textarea>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"prioridad\">De los que has mencionado, ¿cuál consideras el más prioritario?<span class=\"required\">*</span></label>\n                <input type=\"text\" id=\"prioridad\" name=\"prioridad\" placeholder=\"Ej: La gestión de facturas\" required>\n            </div>\n            \n            <div class=\"form-group\">\n                <label for=\"valor\">¿Cuánto valor supondría automatizar estos procesos en tu día a día?<span class=\"required\">*</span></label>\n                <input type=\"text\" id=\"valor\" name=\"valor\" placeholder=\"Ej: Me ahorraría 2 horas diarias y reduciría errores\" required>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"inversion\">¿Estarías dispuesto a invertir en conseguir resolver esos procesos?<span class=\"required\">*</span></label>\n                <select id=\"inversion\" name=\"inversion\" required>\n                    <option value=\"\" disabled selected>Selecciona una opción</option>\n                    <option value=\"si_claro\">Sí, lo tengo claro</option>\n                    <option value=\"informandome\">No, estoy simplemente informándome</option>\n                    <option value=\"dudas\">Sí, pero tengo dudas</option>\n                    <option value=\"sin_capital\">Sí, aunque no tengo capital aún</option>\n                    <option value=\"presupuestos\">Estoy pidiendo presupuesto a varias empresas</option>\n                </select>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"email\">Dirección de correo<span class=\"required\">*</span></label>\n                <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"ejemplo@gmail.com\" required>\n            </div>\n            \n            <div class=\"form-group\">\n                <label for=\"telefono\">Número de teléfono<span class=\"required\">*</span></label>\n                <input type=\"tel\" id=\"telefono\" name=\"telefono\" placeholder=\"+34 659487594\" required>\n            </div>\n\n            <button type=\"submit\" class=\"submit-btn\">Enviar Información</button>\n        </form>\n    </div>\n\n</body>\n</html>"
        }
