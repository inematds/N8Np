      "id": "29ec9cce-9cd8-4f5a-bce6-4e5e6e343010",
      "name": "Get Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        140,
        -1020
      ],
      "alwaysOutputData": true
