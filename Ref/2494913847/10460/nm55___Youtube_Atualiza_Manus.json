    {
      "parameters": {
        "jsCode": "// Processar dados para o prompt do Claude\nconst videoInfo = $node[\"Get Video Info\"].json.items[0];\nconst transcriptRaw = $node[\"Get Transcript\"].json.transcript;\n\n// Extrair informações do vídeo\nconst title = videoInfo.snippet.title;\nconst description = videoInfo.snippet.description;\nconst channelTitle = videoInfo.snippet.channelTitle;\nconst publishedAt = videoInfo.snippet.publishedAt;\nconst viewCount = videoInfo.statistics.viewCount;\n\n// Processar transcrição\nlet transcript = '';\nif (Array.isArray(transcriptRaw)) {\n  transcript = transcriptRaw.map(item => item.text || item).join(' ');\n} else if (typeof transcriptRaw === 'string') {\n  transcript = transcriptRaw;\n}\n\n// Limpar transcrição\ntranscript = transcript\n  .replace(/\\[.*?\\]/g, '') // Remove timestamps\n  .replace(/\\s+/g, ' ')    // Normaliza espaços\n  .trim();\n\nif (!transcript || transcript.length < 50) {\n  throw new Error('Transcrição muito curta ou não encontrada');\n}\n\n// Criar prompt para Claude\nconst claudePrompt = `Você é um especialista em resumos claros e informativos para YouTube. Analise a transcrição abaixo e produza um resumo estruturado.\n\nINFORMAÇÕES DO VÍDEO:\n- Título: ${title}\n- Canal: ${channelTitle}\n- Visualizações: ${viewCount}\n- Publicado em: ${publishedAt}\n\nTRANSCRIÇÃO:\n${transcript}\n\nTAREFAS:\n1. Crie um resumo por tópicos com frases curtas e impactantes\n2. Destaque os aprendizados principais se for conteúdo educativo\n3. Inclua frases de impacto se for conteúdo motivacional\n4. Adicione uma chamada para ação no final\n5. Use bullet points e subtítulos quando apropriado\n6. Mantenha o tom do canal original\n\nFORMATO DE RESPOSTA:\n{\n  \"summary\": \"Resumo completo estruturado\",\n  \"key_points\": [\"Ponto 1\", \"Ponto 2\", \"Ponto 3\"],\n  \"call_to_action\": \"Chamada para ação\",\n  \"thumbnail_description\": \"Descrição visual para thumbnail baseada no conteúdo\"\n}`;\n\n// Criar prompt para thumbnail\n//const thumbnailPrompt = `Crie uma thumbnail cativante para YouTube sobre: ${transcript}. Estilo: moderno, cores vibrantes, composição profissional, proporção 16:9, alta qualidade, sem texto sobreposto.`;\n\nreturn {\n  video_title: title,\n  channel_title: channelTitle,\n  transcript: transcript,\n  transcript_length: transcript.length,\n  claude_prompt: claudePrompt,\n  //thumbnail_prompt: thumbnailPrompt,\n  video_stats: {\n    views: viewCount,\n    published: publishedAt\n  }\n};\n"
      },
      "id": "63dc0019-1067-4de6-ba36-3d6ebfbed69e",
      "name": "Prepare AI Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        -1060
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extrair dados dos nós anteriores\n//const summaryData = $node[\"Generate Summary (Claude)\"].json;\nconst summaryData = $node[\"AI Agent\"].json;\nconst videoData = $node[\"Get Video Info\"].json.items[0];\nconst videoId = $json.video_id;\n\n// Descrição original do vídeo\nconst originalDescription = videoData.snippet.description;\n\n// Garantir que key_points seja um array\nconst keyPoints = Array.isArray(summaryData.key_points) ? summaryData.key_points : ['Nenhum ponto principal encontrado'];\n\n// Montar nova descrição\nconst newDescription = `${summaryData.summary}\n\nPONTOS PRINCIPAIS:\n${keyPoints.map(point => `- ${point}`).join('\\n')}\n\n${summaryData.call_to_action}\n\n---\n\n${originalDescription}`;\n\n// Retornar objeto final\nreturn {\n  video_id: videoId,\n  new_description: newDescription,\n  thumbnail_url: $json.thumbnail_url,\n  summary_data: summaryData,\n  video_title: videoData.snippet.title,\n  channel_title: videoData.snippet.channelTitle,\n  processed_at: new Date().toISOString()\n};\n"
      },
