    {
      "parameters": {
        "description": "Analyze graph patterns and identify key relationships",
        "jsCode": "// Graph analysis tool for identifying patterns and relationships\n// Input: query should contain graph data or analysis request\n\n// Parse the input query to extract graph data or analysis type\nconst analysisRequest = query.toLowerCase();\n\n// Mock graph analysis - in real implementation, this would connect to actual graph database\nif (analysisRequest.includes('centrality')) {\n  return 'Centrality analysis: Identified key nodes with highest betweenness centrality scores. Top influential nodes: Node_A (0.85), Node_B (0.72), Node_C (0.68)';\n} else if (analysisRequest.includes('community')) {\n  return 'Community detection: Found 3 distinct communities with modularity score 0.82. Largest community contains 45% of nodes with strong internal connections.';\n} else if (analysisRequest.includes('path')) {\n  return 'Path analysis: Shortest path algorithms executed. Average path length: 3.2 hops. Critical bridge nodes identified that connect major components.';\n} else if (analysisRequest.includes('cluster')) {\n  return 'Clustering analysis: Hierarchical clustering revealed 5 major clusters. Silhouette score: 0.76 indicating well-separated clusters.';\n} else {\n  return 'General graph analysis: Network contains ' + Math.floor(Math.random() * 1000 + 100) + ' nodes and ' + Math.floor(Math.random() * 5000 + 500) + ' edges. Density: 0.15, Average degree: 4.2';\n}"
      },
      "id": "e9a61aff-2f2e-4d43-9af0-64db5faf8b02",
      "name": "Graph Analysis Tool",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        704,
        224
      ]
    },
    {
      "parameters": {
        "description": "Extract entities and relationships from text",
        "jsCode": "// Extract entities and relationships from text\n// Input: query (string) - the text to analyze\n\nconst text = query;\nconst entities = [];\nconst relationships = [];\n\n// Simple entity extraction patterns\nconst patterns = {\n  person: /\\b[A-Z][a-z]+ [A-Z][a-z]+\\b/g,\n  organization: /\\b[A-Z][a-z]+ (?:Inc|Corp|LLC|Ltd|Company|Organization)\\b/g,\n  location: /\\b(?:in|at|from) ([A-Z][a-z]+(?:, [A-Z][a-z]+)?)\\b/g,\n  date: /\\b(?:January|February|March|April|May|June|July|August|September|October|November|December) \\d{1,2}, \\d{4}\\b/g,\n  email: /\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b/g,\n  phone: /\\b\\d{3}-\\d{3}-\\d{4}\\b/g\n};\n\n// Extract entities\nfor (const [type, pattern] of Object.entries(patterns)) {\n  const matches = text.match(pattern) || [];\n  matches.forEach(match => {\n    entities.push({\n      type: type,\n      value: match.trim(),\n      position: text.indexOf(match)\n    });\n  });\n}\n\n// Extract simple relationships\nconst relationshipPatterns = [\n  { pattern: /(\\w+) works at (\\w+)/gi, relation: 'works_at' },\n  { pattern: /(\\w+) is located in (\\w+)/gi, relation: 'located_in' },\n  { pattern: /(\\w+) owns (\\w+)/gi, relation: 'owns' },\n  { pattern: /(\\w+) manages (\\w+)/gi, relation: 'manages' }\n];\n\nrelationshipPatterns.forEach(({ pattern, relation }) => {\n  let match;\n  while ((match = pattern.exec(text)) !== null) {\n    relationships.push({\n      subject: match[1],\n      predicate: relation,\n      object: match[2]\n    });\n  }\n});\n\n// Return structured result\nconst result = {\n  entities: entities,\n  relationships: relationships,\n  entity_count: entities.length,\n  relationship_count: relationships.length\n};\n\nreturn JSON.stringify(result, null, 2);"
      },
