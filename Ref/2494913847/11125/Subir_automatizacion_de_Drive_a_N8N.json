      "id": "05b5eccd-48da-41ce-a41d-15eba90f3c1b",
      "name": "Create a workflow",
      "credentials": {
        "n8nApi": {
          "id": "[REMOVED]",
          "name": "n8n account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// --------------------------------------------------------\n// 0) Coger el item y la complejidad\n// --------------------------------------------------------\nconst item = $input.item;\nconst complejidad = item.json.Complejidad || '';\n\n// --------------------------------------------------------\n// 1) Leer el JSON original desde el binario de “Download file”\n// --------------------------------------------------------\nconst downloadItem = $items(\"Download file\")[0];\nif (!downloadItem || !downloadItem.binary) {\n  throw new Error('No se ha encontrado el nodo “Download file” o no tiene datos binarios');\n}\nconst binKey = Object.keys(downloadItem.binary)[0];\nconst b64    = downloadItem.binary[binKey].data;\nconst buff   = Buffer.from(b64, 'base64');\nconst rawWF  = JSON.parse(buff.toString('utf8'));\n\n// --------------------------------------------------------\n// 2) Clonar el workflow\n// --------------------------------------------------------\nconst workflow = JSON.parse(JSON.stringify(rawWF));\n\n// --------------------------------------------------------\n// 3) Crear el nuevo título\n// --------------------------------------------------------\nconst nameFromDownload = downloadItem.json.name || '';\nconst nuevoTitulo      = `${complejidad} ${nameFromDownload}`.trim();\n\n// --------------------------------------------------------\n// 4) Asignar el título al nombre del workflow\n// --------------------------------------------------------\nworkflow.name = nuevoTitulo;\n\n// --------------------------------------------------------\n// 5) (Opcional) Si quieres seguir modificando también el primer nodo,\n//     podrías hacerlo así:\n// workflow.nodes[0].name = nuevoTitulo;\n// --------------------------------------------------------\n\n// --------------------------------------------------------\n// 6) Devolver TODO el workflow modificado\n// --------------------------------------------------------\nreturn [\n  {\n    json: workflow,\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        2180
      ],
      "id": "22d3add5-96f7-4e2a-bbb1-c2b930960033",
      "name": "Code"
    },
