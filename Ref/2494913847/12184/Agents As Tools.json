      "id": "274c58db-a31d-4af8-ae18-5ace890701f7",
      "name": "Web Search Tool",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [
        -560,
        1120
      ]
    },
    {
      "parameters": {
        "description": "Search technical documentation database, API references, and known issues. Returns structured results with relevance scoring to help answer technical questions and troubleshoot problems.",
        "jsCode": "// Documentation Search Tool with API reference and known issues lookup\n// Input: query - search terms or technical question\n\nconst searchQuery = query.toLowerCase().trim();\n\n// Mock documentation database - in production, this would connect to your actual docs API\nconst documentationDB = {\n  apiReference: [\n    {\n      title: \"Authentication API\",\n      content: \"Use Bearer tokens for API authentication. Include Authorization header with 'Bearer <token>' format.\",\n      category: \"api\",\n      relevance: 0\n    },\n    {\n      title: \"User Management API\",\n      content: \"CRUD operations for user accounts. Endpoints: GET /users, POST /users, PUT /users/{id}, DELETE /users/{id}\",\n      category: \"api\",\n      relevance: 0\n    },\n    {\n      title: \"Webhook Configuration\",\n      content: \"Configure webhooks to receive real-time notifications. Set endpoint URL and select event types.\",\n      category: \"api\",\n      relevance: 0\n    }\n  ],\n  knownIssues: [\n    {\n      title: \"Rate Limiting Error 429\",\n      content: \"API rate limits exceeded. Implement exponential backoff retry logic. Default limit: 100 requests/minute.\",\n      category: \"issue\",\n      solution: \"Add retry logic with exponential backoff. Check rate limit headers in response.\",\n      relevance: 0\n    },\n    {\n      title: \"Webhook Delivery Failures\",\n      content: \"Webhooks failing to deliver. Common causes: invalid SSL certificates, unreachable endpoints, timeout issues.\",\n      category: \"issue\",\n      solution: \"Verify SSL certificate, check endpoint accessibility, increase timeout settings.\",\n      relevance: 0\n    },\n    {\n      title: \"Authentication Token Expiry\",\n      content: \"Access tokens expire after 24 hours. Refresh tokens valid for 30 days.\",\n      category: \"issue\",\n      solution: \"Implement token refresh logic before expiry. Store refresh tokens securely.\",\n      relevance: 0\n    }\n  ],\n  generalDocs: [\n    {\n      title: \"Getting Started Guide\",\n      content: \"Complete setup guide for new users. Covers account creation, API key generation, and first API call.\",\n      category: \"guide\",\n      relevance: 0\n    },\n    {\n      title: \"Integration Best Practices\",\n      content: \"Recommended patterns for integrating with our platform. Includes error handling, retry logic, and security considerations.\",\n      category: \"guide\",\n      relevance: 0\n    },\n    {\n      title: \"Troubleshooting Common Issues\",\n      content: \"Solutions for frequently encountered problems. Covers connection issues, data formatting, and performance optimization.\",\n      category: \"guide\",\n      relevance: 0\n    }\n  ]\n};\n\n// Calculate relevance scores based on search query\nfunction calculateRelevance(item, query) {\n  const searchTerms = query.split(' ');\n  let score = 0;\n  \n  searchTerms.forEach(term => {\n    if (item.title.toLowerCase().includes(term)) score += 3;\n    if (item.content.toLowerCase().includes(term)) score += 2;\n    if (item.solution && item.solution.toLowerCase().includes(term)) score += 2;\n  });\n  \n  return score;\n}\n\n// Search all documentation categories\nconst allDocs = [\n  ...documentationDB.apiReference,\n  ...documentationDB.knownIssues,\n  ...documentationDB.generalDocs\n];\n\n// Calculate relevance and filter results\nconst searchResults = allDocs\n  .map(doc => ({\n    ...doc,\n    relevance: calculateRelevance(doc, searchQuery)\n  }))\n  .filter(doc => doc.relevance > 0)\n  .sort((a, b) => b.relevance - a.relevance)\n  .slice(0, 5); // Top 5 results\n\n// Format results\nif (searchResults.length === 0) {\n  return `No documentation found for \"${query}\". Try different search terms or contact support for assistance.`;\n}\n\nlet response = `Found ${searchResults.length} relevant documentation entries for \"${query}\":\\n\\n`;\n\nsearchResults.forEach((result, index) => {\n  response += `${index + 1}. **${result.title}** (${result.category.toUpperCase()}) - Relevance: ${result.relevance}\\n`;\n  response += `   ${result.content}\\n`;\n  \n  if (result.solution) {\n    response += `   **Solution:** ${result.solution}\\n`;\n  }\n  \n  response += '\\n';\n});\n\nresponse += 'Need more specific help? Please provide additional details about your use case.';\n\nreturn response;"
      },
