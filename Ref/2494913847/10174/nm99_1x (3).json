    {
      "parameters": {
        "jsCode": "// CÓDIGO CORRIGIDO - Para usar APÓS adicionar o nó da OpenAI\nconst fileData = $('Google Drive - Baixar JSON').first().json;\nconst openaiResponse = $input.first().json; // Resposta completa da OpenAI\n\ntry {\n  // Extrair o conteúdo da análise da OpenAI\n  let analysisText;\n  \n  // Verificar diferentes estruturas possíveis da resposta da OpenAI\n  if (openaiResponse.choices && Array.isArray(openaiResponse.choices) && openaiResponse.choices[0]) {\n    // Estrutura padrão da OpenAI API\n    if (openaiResponse.choices[0].message && openaiResponse.choices[0].message.content) {\n      analysisText = openaiResponse.choices[0].message.content;\n    } else if (openaiResponse.choices[0].text) {\n      analysisText = openaiResponse.choices[0].text;\n    }\n  } else if (openaiResponse.content) {\n    // Campo content direto\n    analysisText = openaiResponse.content;\n  } else if (openaiResponse.text) {\n    // Campo text direto\n    analysisText = openaiResponse.text;\n  } else if (typeof openaiResponse === 'string') {\n    // Resposta é uma string direta\n    analysisText = openaiResponse;\n  }\n  \n  if (!analysisText) {\n    throw new Error('Não foi possível extrair o texto da análise da resposta da OpenAI');\n  }\n  \n  // Limpar o texto se necessário (remover markdown code blocks)\n  const cleanText = analysisText.trim().replace(/^```json\\s*/, '').replace(/\\s*```$/, '');\n  \n  // Parse da análise JSON\n  const analysis = JSON.parse(cleanText);\n\n  // Dados do arquivo original\n  const fileName = fileData.name;\n  const fileId = $('Split - Cada Arquivo').first().json.id;\n  const fileLink = `https://drive.google.com/file/d/${fileId}/view`;\n \n  // Preparar dados consolidados\n  const consolidatedData = {\n    // Informações básicas\n    id: `wf_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n    nome_arquivo: fileName,\n    nome_workflow: analysis.nome || fileName.replace('.json', ''),\n    link_arquivo: fileLink,\n    data_processamento: new Date().toISOString(),\n    \n    // Análise da OpenAI\n    descricao: analysis.descricao || '',\n    categoria: analysis.categoria || 'Geral',\n    subcategoria: analysis.subcategoria || '',\n    servicos: Array.isArray(analysis.servicos) ? analysis.servicos : [],\n    complexidade: analysis.complexidade || 'Moderado',\n    tipo_automacao: analysis.tipo_automacao || 'Manual',\n    casos_uso: Array.isArray(analysis.casos_uso) ? analysis.casos_uso : [],\n    publico_alvo: analysis.publico_alvo || '',\n    beneficios: Array.isArray(analysis.beneficios) ? analysis.beneficios : [],\n    tags: Array.isArray(analysis.tags) ? analysis.tags : [],\n    tempo_implementacao: analysis.tempo_implementacao || '30-60 minutos',\n    prerequisitos: Array.isArray(analysis.prerequisitos) ? analysis.prerequisitos : [],\n    numero_nos: analysis.numero_nos || 0,\n    tem_webhook: analysis.tem_webhook || false,\n    tem_agendamento: analysis.tem_agendamento || false,\n    tem_condicoes: analysis.tem_condicoes || false,\n    nivel_dificuldade: analysis.nivel_dificuldade || 'Intermediário',\n    \n    // Para Google Sheets (array ordenado)\n    sheets_row: [\n      analysis.nome || fileName.replace('.json', ''),\n      analysis.descricao || '',\n      analysis.categoria || 'Geral',\n      analysis.subcategoria || '',\n      Array.isArray(analysis.servicos) ? analysis.servicos.join(', ') : '',\n      analysis.complexidade || 'Moderado',\n      analysis.tipo_automacao || 'Manual',\n      Array.isArray(analysis.casos_uso) ? analysis.casos_uso.join('; ') : '',\n      analysis.publico_alvo || '',\n      Array.isArray(analysis.beneficios) ? analysis.beneficios.join('; ') : '',\n      Array.isArray(analysis.tags) ? analysis.tags.join(', ') : '',\n      analysis.tempo_implementacao || '30-60 minutos',\n      Array.isArray(analysis.prerequisitos) ? analysis.prerequisitos.join('; ') : '',\n      analysis.numero_nos || 0,\n      analysis.tem_webhook ? 'Sim' : 'Não',\n      analysis.tem_agendamento ? 'Sim' : 'Não',\n      analysis.tem_condicoes ? 'Sim' : 'Não',\n      analysis.nivel_dificuldade || 'Intermediário',\n      fileLink,\n      new Date().toLocaleDateString('pt-BR')\n    ],\n    \n    // Para RAG (texto completo estruturado)\n    texto_rag: `Nome: ${analysis.nome || fileName.replace('.json', '')}\\n\\nDescrição: ${analysis.descricao || ''}\\n\\nCategoria: ${analysis.categoria || 'Geral'}\\n\\nSubcategoria: ${analysis.subcategoria || ''}\\n\\nServiços utilizados: ${Array.isArray(analysis.servicos) ? analysis.servicos.join(', ') : ''}\\n\\nComplexidade: ${analysis.complexidade || 'Moderado'}\\n\\nTipo de automação: ${analysis.tipo_automacao || 'Manual'}\\n\\nCasos de uso: ${Array.isArray(analysis.casos_uso) ? analysis.casos_uso.join(', ') : ''}\\n\\nPúblico-alvo: ${analysis.publico_alvo || ''}\\n\\nBenefícios: ${Array.isArray(analysis.beneficios) ? analysis.beneficios.join(', ') : ''}\\n\\nTags: ${Array.isArray(analysis.tags) ? analysis.tags.join(', ') : ''}\\n\\nTempo de implementação: ${analysis.tempo_implementacao || '30-60 minutos'}\\n\\nPré-requisitos: ${Array.isArray(analysis.prerequisitos) ? analysis.prerequisitos.join(', ') : ''}\\n\\nCaracterísticas técnicas:\\n- Número de nós: ${analysis.numero_nos || 0}\\n- Tem webhook: ${analysis.tem_webhook ? 'Sim' : 'Não'}\\n- Tem agendamento: ${analysis.tem_agendamento ? 'Sim' : 'Não'}\\n- Tem condições: ${analysis.tem_condicoes ? 'Sim' : 'Não'}\\n- Nível de dificuldade: ${analysis.nivel_dificuldade || 'Intermediário'}\\n- Arquivo foi ajustado: ${$('If').first().json.ajustado ? 'Sim' : 'Não'}\\n\\nLink do arquivo: ${fileLink}`\n  };\n  \n  return [{ json: consolidatedData }];\n  \n} catch (error) {\n  return [{\n    json: {\n      error: true,\n      message: `Erro ao processar resposta da OpenAI: ${error.message}`,\n      raw_response: JSON.stringify(openaiResponse, null, 2),\n      file_name: fileData.name,\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\n$('If').first().json.ajustado\n\n"
      },
