    {
      "parameters": {
        "jsCode": "// 1. Tenta detectar se o conteúdo está no campo json (já parseado pelo n8n)\nif ($json && Object.keys($json).length > 0 && !$binary?.data) {\n  // Já está pronto\n  return [{ json: { parsed: $json, status: 'ok' } }];\n}\n\n// 2. Se for binário, tenta converter e limpar\nconst bin = $input.item.binary?.data;\nif (!bin) {\n  return [{ json: { erro: true, mensagem: 'Nenhum dado binário encontrado.', status: 'falha' } }];\n}\n\ntry {\n  // Converte de base64 para string\n  const texto = Buffer.from(bin.data, 'base64').toString();\n  \n  // NOVA LÓGICA: Encontra onde termina o primeiro JSON válido\n  function encontrarPrimeiroJson(content) {\n    let braceCount = 0;\n    let inString = false;\n    let escaped = false;\n    let startFound = false;\n    \n    for (let i = 0; i < content.length; i++) {\n      const char = content[i];\n      \n      // Handle escape sequences\n      if (escaped) {\n        escaped = false;\n        continue;\n      }\n      \n      if (char === '\\\\') {\n        escaped = true;\n        continue;\n      }\n      \n      // Handle strings (ignore braces inside strings)\n      if (char === '\"') {\n        inString = !inString;\n        continue;\n      }\n      \n      // Only count braces outside of strings\n      if (!inString) {\n        if (char === '{') {\n          braceCount++;\n          startFound = true;\n        } else if (char === '}') {\n          braceCount--;\n          // Se chegou a 0 e já começou, encontrou o final do primeiro JSON\n          if (braceCount === 0 && startFound) {\n            return i + 1; // +1 para incluir o }\n          }\n        }\n      }\n    }\n    \n    // Se não encontrou JSON completo, retorna o tamanho total\n    return content.length;\n  }\n  \n  // Encontra onde o primeiro JSON termina\n  const fimPrimeiroJson = encontrarPrimeiroJson(texto);\n  const jsonBruto = texto.slice(0, fimPrimeiroJson);\n  \n  // Tenta fazer parse\n  const jsonValido = JSON.parse(jsonBruto);\n  \n  return [{ json: { parsed: jsonValido, status: 'ok', ajustado: fimPrimeiroJson < texto.length } }];\n  \n} catch (err) {\n  // FALLBACK: Se a nova lógica falhar, tenta a abordagem original\n  try {\n    const texto = Buffer.from(bin.data, 'base64').toString();\n    \n    // Método alternativo mais simples: procura por '}{'\n    const indiceDuplicacao = texto.indexOf('}{');\n    let jsonBruto;\n    \n    if (indiceDuplicacao !== -1) {\n      // Se encontrou duplicação, corta no primeiro\n      jsonBruto = texto.slice(0, indiceDuplicacao + 1);\n    } else {\n      // Se não encontrou, usa a lógica original\n      const fim = texto.lastIndexOf('}') + 1;\n      jsonBruto = texto.slice(0, fim);\n    }\n    \n    const jsonValido = JSON.parse(jsonBruto);\n    return [{ json: { parsed: jsonValido, status: 'ok', ajustado: indiceDuplicacao !== -1 } }];\n    \n  } catch (fallbackErr) {\n    return [{\n      json: {\n        erro: true,\n        mensagem: `Erro principal: ${err.message}. Fallback: ${fallbackErr.message}`,\n        status: 'falha',\n        trecho: bin.data ? bin.data.slice(0, 300) + '...' : 'n/a'\n      }\n    }];\n  }\n}"
      },
