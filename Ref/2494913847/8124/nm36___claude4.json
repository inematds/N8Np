    {
      "parameters": {
        "functionCode": "// Validate and format lead data\nconst leadData = $input.first().json;\n\n// Ensure all required fields exist\nconst formattedLead = {\n  firstName: leadData.firstName || '',\n  lastName: leadData.lastName || '',\n  email: leadData.email || '',\n  phone: leadData.phone || '',\n  company: leadData.company || '',\n  jobTitle: leadData.jobTitle || '',\n  source: leadData.source || 'website',\n  interests: leadData.interests || [],\n  leadScore: 0,\n  status: 'new',\n  createdAt: new Date().toISOString()\n};\n\n// Basic lead scoring\nif (formattedLead.email.includes('.com')) formattedLead.leadScore += 10;\nif (formattedLead.company) formattedLead.leadScore += 20;\nif (formattedLead.jobTitle) formattedLead.leadScore += 15;\nif (formattedLead.phone) formattedLead.leadScore += 10;\n\nreturn formattedLead;"
      },
      "id": "94254dbf-da3e-4860-9861-268952b11e3f",
      "name": "Format Lead Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        540,
        1820
      ]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "create"
