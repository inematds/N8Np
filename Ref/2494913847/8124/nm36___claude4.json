          "phone": "={{$json[\"phone\"]}}",
          "rating": "={{$json[\"leadScore\"] >= 40 ? 'Hot' : $json[\"leadScore\"] >= 25 ? 'Warm' : 'Cold'}}",
          "title": "={{$json[\"jobTitle\"]}}"
        }
      },
