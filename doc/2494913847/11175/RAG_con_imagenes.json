        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"mistral-ocr-latest\",\n  \"document\": {\n    \"type\": \"document_url\",\n    \"document_url\": \"{{ $json.url }}\"\n  },\n  \"include_image_base64\": true,\n  \"bbox_annotation_format\": {\n    \"type\": \"text\",\n    \"json_schema\": {\n      \"name\": \"visual_descriptions_only\",\n      \"description\": \"Extrae descripciones concisas en lenguaje natural en ESPAÑOL para cada elemento visual distinto (imagen, gráfico, tabla, diagrama, etc.) en la página. Enfócate en resumir lo que contiene o comunica cada elemento visual.\",\n      \"schema\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\",\n          \"description\": \"Una descripción concisa de un solo elemento visual.\"\n        }\n      },\n      \"strict\": false\n    }\n  }\n}\n",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        180
      ],
      "id": "d11affff-582d-4c87-9274-f75e9b16d31c",
      "name": "Respuesta Mistral",
      "credentials": {
        "mistralCloudApi": {
          "id": "[REMOVED]",
          "name": "Mistral Cloud account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// --- PASO 1: OBTENER TODA LA INFORMACIÓN ---\nlet markdown = $json.markdown;\n\nconst supabaseBaseUrl = $('Edit Fields').item.json.url_supabase;\nconst bucketName = $('Edit Fields').item.json.supabase_storage_bucket_name;\nconst fullBaseUrl = `${supabaseBaseUrl}/storage/v1/object/public/${bucketName}/`;\n\n\n// --- PASO 2: ACCEDER A LOS DATOS DE LA FORMA CORRECTA ---\nconsole.log(\"Accediendo a los datos del nodo Merge1...\");\n\n// BASADO EN TU CAPTURA, ESTA ES LA FORMA CORRECTA DE ACCEDER A LA LISTA DE IMÁGENES:\nconst imagenesProcesadas = $('Merge1').item.json.data;\n\n// Verificación de seguridad\nif (!Array.isArray(imagenesProcesadas) || imagenesProcesadas.length === 0) {\n  console.log(\"ERROR CRÍTICO: No se pudo encontrar un array de datos en la ruta 'Merge1'.item.json.data\");\n  return { ...$json, markdown: markdown, error_message: \"Estructura de datos inesperada en Merge1\" };\n}\nconsole.log(`¡Éxito! Se encontraron ${imagenesProcesadas.length} imágenes en Merge1 para procesar.`);\nconsole.log(\"-----------------------------------------\");\n\n\n// --- PASO 3: PROCESAR Y REEMPLAZAR ---\n// El resto de la lógica estaba bien, solo ajustamos cómo se leen los datos dentro del bucle.\n\nfor (const image of imagenesProcesadas) {\n  // YA NO USAMOS '.json' AQUÍ, porque 'image' ya es el objeto que necesitamos\n  const originalId = image.id_original;\n  const fileName = image.nombre_archivo;\n  const annotation = image.anotacion_imagen || '';\n\n  if (!originalId || !fileName) {\n    console.log(\"ADVERTENCIA: Saltando un item por falta de 'id_original' o 'nombre_archivo'.\", image);\n    continue;\n  }\n\n  const localMarkdownPattern = `![${originalId}](${originalId})`;\n  const hostedMarkdownWithAnnotation = `![${originalId}](${fullBaseUrl}${fileName})\\n\\n${annotation}`;\n  \n  console.log(`Procesando imagen con ID: \"${originalId}\"`);\n  console.log(`Patrón a buscar: \"${localMarkdownPattern}\"`);\n\n  if (markdown.includes(localMarkdownPattern)) {\n    console.log(\"¡Patrón encontrado! Reemplazando...\");\n    markdown = markdown.replaceAll(localMarkdownPattern, hostedMarkdownWithAnnotation);\n  } else {\n    console.log(\"--> ADVERTENCIA: No se encontró el patrón para este ID.\");\n  }\n  console.log(\"-----------------------------------------\");\n}\n\nconsole.log(\"--- PROCESO DE REEMPLAZO FINALIZADO ---\");\n\n// --- PASO 4: DEVOLVER EL RESULTADO ---\nreturn {\n  ...$json,\n  markdown: markdown\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
