    {
      "parameters": {
        "description": "Analyzes retrieved context for relevance and quality",
        "jsCode": "// Analyze retrieved context for relevance and quality\n// Input: query - the context text to analyze\n\nif (!query || typeof query !== 'string') {\n  return 'No context provided for analysis';\n}\n\n// Split context into sentences for analysis\nconst sentences = query.split(/[.!?]+/).filter(s => s.trim().length > 0);\n\n// Calculate basic metrics\nconst wordCount = query.split(/\\s+/).length;\nconst avgSentenceLength = wordCount / sentences.length;\n\n// Check for key indicators of quality content\nconst hasNumbers = /\\d/.test(query);\nconst hasProperNouns = /[A-Z][a-z]+/.test(query);\nconst hasTechnicalTerms = /\\b(API|database|algorithm|framework|protocol|implementation)\\b/i.test(query);\n\n// Assess relevance indicators\nconst relevanceScore = {\n  hasSpecificTerms: hasTechnicalTerms ? 0.3 : 0,\n  hasStructuredData: hasNumbers ? 0.2 : 0,\n  hasProperContext: hasProperNouns ? 0.2 : 0,\n  appropriateLength: (wordCount >= 20 && wordCount <= 500) ? 0.3 : 0\n};\n\nconst totalRelevance = Object.values(relevanceScore).reduce((sum, score) => sum + score, 0);\n\n// Generate analysis summary\nconst analysis = {\n  wordCount: wordCount,\n  sentenceCount: sentences.length,\n  avgSentenceLength: Math.round(avgSentenceLength),\n  relevanceScore: Math.round(totalRelevance * 100),\n  qualityIndicators: {\n    hasNumbers: hasNumbers,\n    hasProperNouns: hasProperNouns,\n    hasTechnicalTerms: hasTechnicalTerms\n  },\n  recommendation: totalRelevance > 0.6 ? 'High quality context' : \n                 totalRelevance > 0.3 ? 'Moderate quality context' : 'Low quality context'\n};\n\nreturn `Context Analysis Results:\n- Word Count: ${analysis.wordCount}\n- Sentences: ${analysis.sentenceCount}\n- Avg Sentence Length: ${analysis.avgSentenceLength} words\n- Relevance Score: ${analysis.relevanceScore}%\n- Quality: ${analysis.recommendation}\n- Contains Numbers: ${analysis.qualityIndicators.hasNumbers}\n- Contains Technical Terms: ${analysis.qualityIndicators.hasTechnicalTerms}\n\nKey Insights: ${analysis.recommendation === 'High quality context' ? 'Context appears comprehensive and relevant.' : analysis.recommendation === 'Moderate quality context' ? 'Context has some relevant information but may need supplementation.' : 'Context may be too generic or incomplete for detailed analysis.'}`;"
      },
