        "messages": {
          "values": [
            {
              "content": "=Take the incoming query and split it into the following parameters separately.\n\nAvailability: This is information regarding the dates the client asked for and if they are available or not.\n\nScreenshot_1: The URL that follows \"Screenshot 1\". If there is no URL, output the string \"null\"\n\nScreenshot_2: The URL that follows \"Screenshot 2\" (if applicable). If there is no URL, output the string \"null\"\n\nQuote: The cost for the specified dates. If there is no quote, output the string \"no quote provided\"\n\n\nphoneNumber: {{ $('Webhook').item.json.body.phone }}\n\nname: {{ $('Webhook').item.json.body.name }}",
              "role": "system"
            },
            {
              "content": "=Here is the incoming query: {{ $('AI Agent').item.json.output }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
