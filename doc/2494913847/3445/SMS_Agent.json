    {
      "parameters": {
        "httpMethod": "POST",
        "path": "96ab7d06-612f-4dcd-a3ae-cd2da8edf24e",
        "options": {}
      },
      "id": "cb832370-466e-47e8-8bae-d4e450c36db2",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
