    {
      "parameters": {
        "jsCode": "/**\n * NOTA IMPORTANTE:\n * Los números de teléfono y nombres en esta agenda son totalmente inventados\n * y se incluyen solo como ejemplo. Debes reemplazarlos por los reales que quieras usar.\n *\n * INPUT:\n * - $json[\"Sender\"] (ej: \"34123456789@s.whatsapp.net\")\n *\n * OUTPUT:\n * - name: nombre si está en el mapa\n * - phone_e164: número con +\n * - sender_jid: el JID original\n * - display: nombre si se conoce, si no el +número\n */\n\nconst jid = $json[\"Sender\"] || '';\n\nfunction digits(x) {\n  return String(x || '').replace(/\\D/g, '');\n}\n\n// Extrae solo los dígitos antes de \"@\"\nconst phoneDigits = digits(jid.split('@')[0]);\n\n// Agenda: teléfono → nombre (usar solo dígitos, con prefijo país)\nconst agenda = {\n  '34111111111': 'Laura Martínez',\n  '34122222222': 'Carlos Gómez',\n  '34133333333': 'María Fernández',\n  '34144444444': 'Javier López',\n  '34155555555': 'Lucía Torres',\n  '34166666666': 'Pedro Sánchez',\n  '34177777777': 'Ana Morales',\n  '34188888888': 'Sergio Ruiz',\n  '34199999999': 'Elena Castillo',\n  '34123456789': 'David Romero',\n  '34987654321': 'Paula Navarro',\n  '34121212121': 'Andrés Herrera',\n  '34909090909': 'Isabel Cruz',\n};\n\nconst name = agenda[phoneDigits] || null;\n\nreturn [\n  {\n    sender_jid: jid || null,\n    phone_e164: phoneDigits ? `+${phoneDigits}` : null,\n    name,\n    display: name || (phoneDigits ? `+${phoneDigits}` : 'desconocido'),\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
