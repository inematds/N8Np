    {
      "parameters": {
        "formTitle": "AI File Analyzer - Upload or URL",
        "formDescription": "Upload a file from your device OR paste a URL to any online file (images, videos, documents, audio). The AI will automatically detect the file type and analyze it.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload File",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".jpg, .jpeg, .png, .gif, .bmp, .webp, .pdf, .doc, .docx, .txt, .mp3, .wav, .m4a, .mp4, .avi, .mov, .mkv"
            },
            {
              "fieldLabel": "Or Enter File URL",
              "placeholder": "Paste URL for online images, videos, documents, or audio files"
            }
          ]
        },
        "options": {
          "appendAttribution": true,
          "buttonLabel": "Analyze File",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Your file is being analyzed! Please wait while our AI processes your request."
            }
          },
          "ignoreBots": false,
          "useWorkflowTimezone": true
        }
      },
