    {
      "parameters": {
        "method": "=POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "AIzaSyAv7VbafGNOojN1Xh_pjd8rK59RAHhLkDU"
            }
