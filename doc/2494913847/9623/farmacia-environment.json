  "docker_compose": {
    "version": "3.8",
    "services": {
      "n8n": {
        "image": "n8nio/n8n:latest",
        "container_name": "n8n-farmacia",
        "restart": "unless-stopped",
        "ports": [
          "5678:5678"
        ],
        "environment": {
          "- All variables from production section above -": "..."
        },
        "volumes": [
          "./n8n-data:/home/node/.n8n",
          "./storage:/var/n8n/farmacia/storage",
          "./credentials:/etc/secrets:ro"
        ],
        "networks": [
          "farmacia-network"
        ],
        "depends_on": [
          "postgres",
          "redis"
        ]
      },
      "postgres": {
        "image": "postgres:14-alpine",
        "container_name": "postgres-farmacia",
        "restart": "unless-stopped",
        "environment": {
          "POSTGRES_USER": "farmacia_user",
          "POSTGRES_PASSWORD": "secure_password_here",
          "POSTGRES_DB": "farmacia_db",
          "POSTGRES_INITDB_ARGS": "--encoding=UTF-8 --lc-collate=pt_BR.utf8 --lc-ctype=pt_BR.utf8"
        },
        "volumes": [
          "./postgres-data:/var/lib/postgresql/data",
          "./schema.sql:/docker-entrypoint-initdb.d/schema.sql:ro"
        ],
        "networks": [
          "farmacia-network"
        ],
        "ports": [
          "5432:5432"
        ]
      },
      "redis": {
        "image": "redis:7-alpine",
        "container_name": "redis-farmacia",
        "restart": "unless-stopped",
        "command": "redis-server --appendonly yes --requirepass secure_redis_password",
        "volumes": [
          "./redis-data:/data"
        ],
        "networks": [
          "farmacia-network"
        ],
        "ports": [
          "6379:6379"
        ]
      },
      "evolution": {
        "image": "evolution-api/evolution-api:latest",
        "container_name": "evolution-farmacia",
        "restart": "unless-stopped",
        "environment": {
          "AUTHENTICATION_API_KEY": "evolution_api_key_here",
          "DATABASE_PROVIDER": "postgresql",
          "DATABASE_CONNECTION_URI": "postgresql://user:pass@postgres:5432/evolution",
          "REDIS_URI": "redis://:password@redis:6379",
          "WEBHOOK_URL": "http://n8n:5678/webhook/farmacia-receitas"
        },
        "volumes": [
          "./evolution-data:/evolution/instances"
        ],
        "networks": [
          "farmacia-network"
        ],
        "ports": [
          "8080:8080"
        ],
        "depends_on": [
          "postgres",
          "redis"
        ]
      }
    },
    "networks": {
      "farmacia-network": {
        "driver": "bridge"
      }
    },
    "volumes": {
      "n8n-data": {},
      "postgres-data": {},
      "redis-data": {},
      "evolution-data": {},
      "storage": {}
    }
  },
  "kubernetes": {
    "namespace": "farmacia",
    "configmap": {
      "name": "farmacia-config",
      "data": "All non-sensitive environment variables"
    },
    "secrets": {
      "name": "farmacia-secrets",
      "data": "All sensitive environment variables (base64 encoded)"
    },
    "persistent_volumes": [
      {
        "name": "n8n-data",
        "size": "10Gi",
        "path": "/home/node/.n8n"
      },
      {
        "name": "storage-data",
        "size": "50Gi",
        "path": "/var/n8n/farmacia/storage"
      }
    ],
    "services": [
      {
        "name": "n8n-service",
        "type": "LoadBalancer",
        "port": 443,
        "targetPort": 5678
      },
      {
        "name": "postgres-service",
        "type": "ClusterIP",
        "port": 5432
      },
      {
        "name": "redis-service",
        "type": "ClusterIP",
        "port": 6379
      }
    ],
    "ingress": {
      "host": "n8n.farmacia.com.br",
      "tls": true,
      "certManager": true
    }
  }
}