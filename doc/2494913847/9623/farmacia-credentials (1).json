    "evolution_webhook": "https://n8n.farmacia.com/webhook/farmacia-receitas"
  },
  "external_services": {
    "whatsapp": {
      "provider": "Evolution API",
      "instance_name": "farmacia-instance",
      "webhook_url": "https://n8n.farmacia.com/webhook/farmacia-receitas",
      "qr_code_endpoint": "/instance/connect",
      "features": [
        "buttons",
        "media",
        "typing",
        "presence"
      ]
    },
    "email": {
      "provider": "Gmail",
      "imap_server": "imap.gmail.com",
      "smtp_server": "smtp.gmail.com",
      "folders": [
        "INBOX",
        "Receitas",
        "Processadas"
      ]
    },
    "ocr": {
      "primary": "AWS Textract",
      "secondary": "Google Vision API",
      "fallback": "Tesseract (local)",
      "supported_formats": [
        "image/jpeg",
        "image/png",
        "image/bmp",
        "application/pdf"
      ]
    },
    "storage": {
      "provider": "Local File System",
      "alternative": "S3-compatible (MinIO)",
      "backup": "Google Drive"
    },
    "database": {
      "provider": "PostgreSQL",
      "version": "14+",
      "backup_schedule": "daily",
      "retention_days": 730
    },
    "cache": {
      "provider": "Redis",
      "ttl_prices": 3600,
      "ttl_sessions": 86400
    }
  }
