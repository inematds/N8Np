        "jsCode": "const bin = items[0].binary || {};\nconst key = bin.srt ? 'srt' : bin.ttml ? 'ttml' : bin.data ? 'data' : Object.keys(bin)[0];\nif (!key) return [{ json: { error: 'Nenhum binário encontrado no item' } }];\n\nconst raw = Buffer.from(bin[key].data, 'base64').toString('utf8');\n\n// se a API devolveu JSON de erro por engano\ntry {\n  const maybe = JSON.parse(raw);\n  if (maybe?.error) return [{ json: { error: 'API retornou erro', details: maybe } }];\n} catch {}\n\nlet transcript;\nif (/</.test(raw.slice(0, 20)) && /<\\/body>/i.test(raw)) {\n  // TTML\n  let body = raw.match(/<body[\\s\\S]*<\\/body>/i)?.[0] || raw;\n  transcript = body\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/p>/gi, '\\n')\n    .replace(/<\\/div>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<')\n    .replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&#39;/g,\"'\")\n    .replace(/\\s{2,}/g, ' ').replace(/\\n{2,}/g, '\\n').trim();\n} else {\n  // SRT\n  transcript = raw\n    .replace(/\\r/g, '')\n    .replace(/^\\d+\\s*$/gm, '')\n    .replace(/^\\d{2}:\\d{2}:\\d{2},\\d{3}\\s-->\\s\\d{2}:\\d{2}:\\d{2},\\d{3}\\s*$/gm, '')\n    .replace(/\\n{2,}/g, '\\n')\n    .trim();\n}\n\nreturn [{ json: { transcript, sourceBinaryKey: key } }];\n"
      },
