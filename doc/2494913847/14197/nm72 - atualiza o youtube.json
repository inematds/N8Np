      "parameters": {
        "jsCode": "const raw = $json.output ?? '';\nlet s = typeof raw === 'string' ? raw : JSON.stringify(raw);\n\n// limpar blocos ``` e escapes\ns = s.replace(/^```(?:json)?\\s*/i,'')\n     .replace(/\\s*```$/i,'')\n     .replace(/\\\\[nrt]/g,' ')\n     .replace(/\\s{2,}/g,' ')\n     .trim();\n\n// tentar parsear\nlet j=null; try{ j=JSON.parse(s); }catch{}\n\n// montar descrição final (ou usar s se não for JSON)\nconst desc = j ? [\n  'Miniatura estilo YouTube, layout comercial marcante.',\n  `Cena: ${j['pessoa_referencia']||'empreendedor tecnológico'} meio-corpo, ${j['acao_ou_emocao_da_pessoa']||'pose confiante'} .`,\n  `Ao fundo: ${j['fundo_tematico']||'escritório moderno high-tech'} , levemente desfocado (bokeh).`,\n  `Elemento simbólico: ${j['elemento_visual_inesperado_ou_simbolico']||'elementos futuristas coerentes com o tema'}.`,\n  `Texto sobreposto: '${(j['frase_curta_impactante']||'Domine a Automação Agora')}' — caixa alta, sans-serif em negrito, branco com contorno preto espesso e leve sombra; legível; sem outras palavras.`,\n  `Composição: ${(j['composicao']||'regra dos terços; área limpa para o texto; margens seguras de 10%')}.`,\n  `Estilo: ${(j['style']||'foto realista, iluminação cinematográfica, alto contraste')}.`,\n  `Paleta: ${(j['cores_dominantes']||'cores vibrantes e contrastantes')}.`,\n  `Não incluir: ${(j['nao_incluir']||'marcas d’água, bordas, texto longo, conteúdo sensível, mãos deformadas, dedos extras, fundo poluído')}.`,\n  'Tamanho 1792×1024 (16:9).'\n].join(' ').replace(/\\s{2,}/g,' ').trim() : s;\n\nreturn [{ json: { clean_prompt: desc } }];\n"
      },
