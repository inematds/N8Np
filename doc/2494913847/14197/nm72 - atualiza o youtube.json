    {
      "parameters": {
        "method": "PUT",
        "url": "=https://www.googleapis.com/youtube/v3/videos?part=snippet",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\nJSON.stringify(\n  (() => {\n    const gv  = $(\"📊 Get Video Info\").item.json.items?.[0] ?? {};\n    const sn  = gv.snippet ?? {};\n    const out = $(\"🤖 Generate Summary\").item.json.output ?? {};\n\n    const topo =\n      `${out.Sumario ?? \"\"}\\n\\n` +\n      `Pontos Chaves:\\n${out[\"Pontos Chaves\"] ?? \"\"}\\n\\n` +\n      `Convite:\\n${out.CTA ?? \"\"}\\n\\n` +\n      `📺 Resumo gerado automaticamente com IA\\n\\n---\\n`;\n\n    // novo no topo + original depois\n    let description = (topo + (sn.description ?? \"\")).replace(/\\r/g, \"\");\n    // margem de segurança (< 5000 chars)\n    if (description.length > 4900) description = description.slice(0, 4897) + \"...\";\n\n    return {\n      id: gv.id,\n      snippet: {\n        title: sn.title,\n        description,\n        categoryId: sn.categoryId || \"27\",\n        tags: Array.isArray(sn.tags) ? sn.tags : [],\n        defaultLanguage: \"pt-BR\",\n        defaultAudioLanguage: \"pt-BR\"\n      }\n    };\n  })()\n)\n}}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
