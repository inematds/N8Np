    {
      "parameters": {
        "jsCode": "const all = $input.all();\n\nreturn all.map(item => {\n  const words = item.json.words;  \n\n  const result = [];\n  for (let i = 0; i < words.length; i += 3) {\n    const chunk = words.slice(i, i + 3);\n    result.push({\n      words: chunk.map(word => word.word.charAt(0).toUpperCase() + word.word.slice(1)).join(' '),\n      start: chunk[0].start,\n      end: chunk[chunk.length - 1].end,\n    });\n  }\n  \n  return {\n      chunks: result,\n  };\n})\n\n\n"
      },
      "id": "31618e92-20b9-40ad-b5ac-2c3ff145833e",
      "name": "Combine Transcript",
      "type": "n8n-nodes-base.code",
