      "id": "8bcc3ecf-150e-47e8-961e-ea8d21499307",
      "name": "Read/Write Files from Disk"
    },
    {
      "parameters": {
        "command": "=ffmpeg \\\n  -ss {{ $('Get Configuration').item.json['starting seconds'] }} -i ./youtube/temp.mp4 \\\n  -i ./youtube/lower.mp4 \\\n  -i ./youtube/bgm.mp3 \\\n  -filter_complex \"\\\n    [0:v]scale=1080:760:force_original_aspect_ratio=increase,crop=1080:760[top];\\\n    [1:v]scale=1080:1160:force_original_aspect_ratio=increase,crop=1080:1160[bottom];\\\n    [top][bottom]vstack[stacked];\\\n    [1:a]volume=1.0[lower_audio];\\\n    [2:a]volume=0.03[bgm];\\\n    [lower_audio][bgm]amix=inputs=2:duration=first[aout]\\\n  \" \\\n  -map \"[stacked]\" \\\n  -map \"[aout]\" \\\n  -c:v libx264 \\\n  -c:a aac \\\n  -r 25 \\\n  -t $(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 ./youtube/lower.mp4) \\\n  ./youtube/concate.mp4 \\\n  -y"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        340,
        1400
      ],
      "id": "8eff1600-3ad2-4302-913e-828e399ae7fa",
      "name": "Concate Video"
    },
    {
      "parameters": {
        "jsCode": "const transcript = $(\"Combine Transcript\").first().json.chunks;\n\n// Parameters\nconst maxWidth = 1080 * 0.8; // 80% of 1080px\nconst baseFontSize = 70;     // Default size for short text\nconst avgCharWidth = 0.6;    // Estimated average character width in px per fontsize point\n\nconst commands = transcript.map((item) => {\n  const start = parseFloat(item.start).toFixed(2);\n  const end = parseFloat(item.end).toFixed(2);\n\n  const text = item.words.replaceAll(\"'\", \"\"); // Escape single quotes if needed\n\n  // Estimate the required font size to fit within maxWidth\n  const estimatedFontSize = Math.min(\n    baseFontSize,\n    Math.floor(maxWidth / (text.length * avgCharWidth))\n  );\n\n  return `drawtext=text='  ${text}  ':enable='between(t,${start},${end})':x=(w-text_w)/2:y=(h-text_h)/2-120:fontsize=${estimatedFontSize}:fontfile='Rubik-Black.ttf':fontcolor=black:box=1:boxcolor=yellow@1:boxborderw=5`;\n}).join(\",\");\n\nreturn [{ json: { drawtextCommands: commands } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        1400
      ],
      "id": "20a3ede6-6853-4c4b-a9d1-1a61f68b6df1",
      "name": "Change to FFMPEG Code"
