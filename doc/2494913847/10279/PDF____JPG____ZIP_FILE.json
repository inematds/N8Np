    {
      "parameters": {
        "jsCode": "// Get all items\nconst newItem = {\n  json: {\n    fileCount: items.length,\n    fileNames: []\n  },\n  binary: {}\n};\n\n// Loop through all items and collect their binary data\nfor (let i = 0; i < items.length; i++) {\n  if (items[i].binary && items[i].binary.data) {\n    // Create a copy of the binary data\n    const binaryData = {...items[i].binary.data};\n    \n    // Modify the filename to make it unique\n    binaryData.fileName = `sample_${i+1}.png`;\n    \n    // Store binary data with index as property name\n    newItem.binary[`data${i}`] = binaryData;\n    \n    // Store filename for reference\n    newItem.json.fileNames.push(binaryData.fileName);\n  }\n}\n\n// Return only one item with all the binary data collected\nreturn [newItem];"
      },
